<% content_for :title, "Open collector" %>

<main class="access-shell">
  <section class="access-panel">
    <p class="eyebrow">Sunflower Vacations</p>
    <h1>IoT Collector</h1>
    <p>Enter the same collector key used by the telemetry device.</p>

    <% if @invalid_key %>
      <p class="form-error" role="alert">That collector key was not recognized.</p>
    <% end %>

    <%= form_with url: access_path, method: :post, class: "key-form" do |form| %>
      <%= form.label :key, "Collector key" %>
      <div class="key-entry">
        <%= form.password_field :key, required: true, autocomplete: "current-password", autofocus: true %>
        <%= form.submit "View data" %>
      </div>
    <% end %>
  </section>
</main>
